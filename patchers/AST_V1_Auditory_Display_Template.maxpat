							}
, 							{
								"box" : 								{
									"code" : "let maxNumConnections =  16;\r\n\r\n//get inlets and outlets\r\nlet paramInletNames = [];\r\nlet inletNames = [];\r\nlet outletNames = [];\r\n\r\n//assing names\r\nfor(let i = 0; i < maxNumConnections; i++)\r\n{\r\n\tparamInletNames.push(\"param\" + i);\r\n\tinletNames.push(\"inlet\" + i);\r\n\toutletNames.push(\"outlet\" + i);\r\n}\r\n\r\n//initialize\r\nfor(let i = 0; i < maxNumConnections; i++)\r\n{\r\n\tthis.patcher.message(\"script\", \"connect\", paramInletNames[i], 0, outletNames[i], 0);\r\n}\r\n\r\n//routing logic\r\nfunction connect(fromInlet, toOutlet, status)\r\n{\r\n\tif(status == 1)\r\n\t{\r\n\t\tthis.patcher.message(\"script\", \"disconnect\", paramInletNames[toOutlet], 0, outletNames[toOutlet], 0);\r\n\t\tthis.patcher.message(\"script\", \"connect\", inletNames[fromInlet], 0, outletNames[toOutlet], 0);\r\n\t}\r\n\telse if(status == 0)\r\n\t{\r\n\t\tthis.patcher.message(\"script\", \"connect\", paramInletNames[toOutlet], 0, outletNames[toOutlet], 0);\r\n\t\tthis.patcher.message(\"script\", \"disconnect\", inletNames[fromInlet], 0, outletNames[toOutlet], 0);\r\n\t}\r\n}",
									"filename" : "none",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
									"id" : "obj-99",
									"maxclass" : "v8.codebox",
									"numinlets" : 1,
									"numoutlets" : 1,
