, 							{
								"box" : 								{
									"code" : "Buffer buffer();\r\nHistory index(0);\r\nHistory rate(0);\r\n\r\n//inputs\r\nplayPause = in1;\r\nstop = in2;\r\nstartPos = in3;\r\nendPos = in4;\r\nstartRate = in5;\r\nplaybackSpeed = in6;\r\n\r\n\r\n//reset index on \"stop\"\r\n//playPause is set to 0 from outside: needed to reset button\r\nif(stop)\r\n{\r\n\tindex = startPos;\r\n}\r\n\r\n\r\n//check playPause transition\r\n//restart ramp\r\nrestartRamp = 0;\r\nif(delta(playPause) == 1)\r\n{\r\n\trestartRamp = 1;\r\n\t\r\n\t//always start with startRate\r\n\t//prevents halting when deltaTime == 0\r\n\trate = startRate;\r\n}\r\n\r\n\r\n//check new starting position\r\n//restart ramp\r\n//reset index\r\nif(abs(delta(startPos)) > 0)\r\n{\r\n\trestartRamp = 1;\r\n\tindex = startPos;\r\n}\r\n\r\nnumDataPoints = dim(buffer);\r\n\r\n//get current samplerate from current and next timestamp\r\n//depedning on the data, the rate can change from value to value\r\nif(index < (endPos - 1))\r\n{\r\n\tcurrent = peek(buffer, index, 0);\r\n\tnext = peek(buffer, index + 1, 0);\r\n\tdeltaTime = abs(next - current);\r\n\t\r\n\t//only change rate, when there is a difference in time\r\n\t//prevents halting when deltaTime == 0\r\n\tif(deltaTime != 0)\r\n\t{\r\n\t\trate = 1 / deltaTime;\r\n\t}\r\n}\r\n//reset at the end\r\nelse\r\n{\r\n\tindex = startPos;\r\n}\r\n\r\n\r\n//ramp to advance index at current rate\r\nramp = phasor(rate * playbackSpeed, restartRamp) * playPause;\r\nif(delta(ramp) < -0.5)\r\n{\r\n\tindex += 1;\r\n}\r\n\r\nout1 = index;\r\nout2 = ramp;",
									"fontface" : 0,
									"fontname" : "<Monospaced>",
									"fontsize" : 12.0,
