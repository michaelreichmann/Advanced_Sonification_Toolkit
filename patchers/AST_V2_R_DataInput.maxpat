                "box": {
                    "code": "let adress;\r\n\r\noutlets = 2;\r\n\r\nfunction SetRoute(adressIn)\r\n{\r\n\tadress = adressIn;\r\n}\r\n\r\nfunction anything()\n{\r\n\tlet output;\r\n\t\n\tlet a = arrayfromargs(messagename, arguments);\r\n\t\r\n\tif(messagename == adress)\r\n\t{\r\n\t\toutput = a.filter(n => typeof n === \"number\" && Number.isFinite(n));\r\n\t\toutlet(0, output); \r\n\t}\r\n\telse if(adress == \"none\")\r\n\t{\r\n\t\toutput = a;\r\n\t\toutlet(0, output); \r\n\t}\t\n}",
