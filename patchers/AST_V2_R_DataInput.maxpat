            {
                "box": {
                    "code": "outlets = 3;\r\n\r\nlet serialPortDict = new Dict(\"serialPortDict\");\r\nlet channelIndex = 1;\r\n\r\nfunction ChangeChannelIndex(index)\r\n{\r\n    channelIndex = index;\r\n}\r\n\r\nfunction SetSerialPorts(portName)\r\n{\r\n    let keys = serialPortDict.getkeys();   \r\n    \r\n    //set first if empty\r\n    if(keys == null)\r\n    {\r\n        serialPortDict.replace(channelIndex,  portName);\r\n        keys = serialPortDict.getkeys(); \r\n    }\r\n    \r\n    let port;\r\n    let keyPresent = false;\r\n    \r\n    //check if key is already there\r\n    for(let i = 0; i < keys.length; i++)\r\n    {\r\n        key  = keys[i];\r\n        port = serialPortDict.get(key);\r\n        \r\n        //check if already in use\r\n        if(port == portName && key != channelIndex)\r\n        {\r\n            keyPresent = true;\r\n            break;\r\n        }\r\n    }\r\n       \r\n    if(keyPresent)\r\n    {\r\n        //remove last entry for this channel\r\n        if(serialPortDict.contains(channelIndex))\r\n        {\r\n            serialPortDict.remove(channelIndex);\r\n        }\r\n\r\n        //disable port\r\n        outlet(0, \"close\");\r\n            \r\n        //change input to receive\r\n        outlet(1, 2);\r\n            \r\n        //set receive to corresponding send\r\n        outlet(2, \"set \" + port);\r\n    }     \r\n    else\r\n    {\r\n        //add to dict\r\n        serialPortDict.replace(channelIndex,  portName);\r\n            \r\n        //enable port\r\n        outlet(0, \"port \" + portName);\r\n        outlet(0, \"open\");\r\n            \r\n        //change input to serial object\r\n        outlet(1, 1);\r\n    }\r\n}",
                    "filename": "none",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
